{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Dev Server",
      "type": "shell",
      "command": "source ~/.nvm/nvm.sh && cd frontend && npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Backend: Dev Server",
      "type": "shell",
      "command": "source ./venv/bin/activate && python3 manage.py runserver",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "backend"
      }
    },
    {
      "label": "Start all dev. servers",
      "dependsOn": ["Frontend: Dev Server", "Backend: Dev Server"],
      "problemMatcher": []
    },
    {
      "label": "Backend: Setup Virtual Environment",
      "type": "shell",
      "command": "rm -rf venv && python3.11 -m venv venv && source venv/bin/activate && pip install --upgrade pip && pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "backend"
      }
    },
    {
      "label": "Backend: Create Django Superuser",
      "type": "shell",
      "command": "source ./venv/bin/activate && python3 manage.py createsuperuser",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "backend"
      }
    },
    {
      "label": "Rebuild SEO Files",
      "type": "shell",
      "command": "source ~/.nvm/nvm.sh && cd frontend && npm run generate:seo",
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
