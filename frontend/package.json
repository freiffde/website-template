{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run generate:seo && nuxt build",
    "dev": "nuxt dev",
    "generate": "npm run generate:seo && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "validate:i18n": "node scripts/validate-translations.js",
    "check:unreferenced-i18n": "node scripts/check-unreferenced-translations.js",
    "check:nuxtlink-paths": "node scripts/check-nuxtlink-paths.js",
    "generate:seo": "node scripts/generate-seo-files.js",
    "test": "vitest",
    "test:i18n": "vitest run tests/i18n.test.js",
    "test:unreferenced-i18n": "vitest run tests/unreferenced-translations.test.js",
    "test:nuxtlink-paths": "vitest run tests/nuxtlink-paths.test.js",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "precommit": "npm run validate:i18n && npm run check:unreferenced-i18n && npm run check:nuxtlink-paths && npm run test:i18n && npm run test:unreferenced-i18n && npm run test:nuxtlink-paths"
  },
  "dependencies": {
    "@nuxt/content": "^3.8.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/i18n": "^10.1.0",
    "@pinia/nuxt": "^0.11.3",
    "better-sqlite3": "^12.4.1",
    "eslint": "^9.36.0",
    "nuxt": "^4.1.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^25.3.0",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.4.6",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "happy-dom": "^15.11.6",
    "vitest": "^4.1.8",
    "vue-i18n": "^10.0.4",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  }
}
